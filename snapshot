#!/usr/bin/env bash
# Linux/X11 screen + circular webcam + microphone/system-audio recorder.
set -Eeuo pipefail

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'EOF'
Usage: ./snapshot [options] [output-file | path/to/dir]

Records the XRandR primary monitor, webcam and microphone; press Ctrl+C to finish.
  --export FORMAT        mp4 (default) or kdenlive
  --devices                 Show monitor, camera and microphone choices
  --monitor NAME         Override the primary monitor (e.g. DP-1)
  --camera DEVICE        Webcam device (default: /dev/video0)
  --mic SOURCE           PulseAudio/PipeWire source (default: default)
  --system-audio SOURCE  Record an output-monitor source (default: default).
                         "default" selects the default output's monitor.
  --camera-size WxH      Supported webcam mode (default: 640x480)
  --camera-fps N         Supported webcam frame rate (default: 30)
  --camera-format FMT    Optional input format, e.g. mjpeg or yuyv422
  --fps N               Screen/output frame rate (default: 30)
  --overlay-size N       Face-circle diameter in pixels (default: 600)
  --overlay-margin N     Distance from selected edges in pixels (default: 24)
  --overlay-position POS Placement (default: bottom-right):
                         top-left, top-center, top-right,
                         center-left, center, center-right,
                         bottom-left, bottom-center, bottom-right
  --no-tray              Disable the recording tray icon
  --no-mirror            Disable webcam horizontal mirroring
  --no-system-audio      Disable system-audio recording
  --dry-run              Print capture/export commands without recording
  -h, --help             Show this help

Default output: ./recording-YYYYmmdd-HHMMSS.mp4 (or .kdenlive with --export kdenlive)
EOF
}

show_devices() {
  local listing default_source device label found=0
  printf '\nScreens  (--monitor NAME)\n'
  if command -v xrandr >/dev/null && listing=$(xrandr --query 2>/dev/null); then
    awk '
      $2 == "connected" {
        for (i=3; i<=NF; i++) {
          if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) {
            resolution=$i; sub(/[+-].*/, "", resolution)
            printf "  %-16s %-12s %s\n", $1, resolution, ($3 == "primary" ? "(primary)" : "")
            found=1; break
          }
        }
      }
      END {if (!found) print "  No active screens found."}
    ' <<< "$listing"
  else
    printf '  Unavailable. Run in an X11 desktop with xrandr installed.\n'
  fi

  printf '\nCameras  (--camera DEVICE)\n'
  if command -v v4l2-ctl >/dev/null && listing=$(v4l2-ctl --list-devices 2>/dev/null) && [[ -n $listing ]]; then
    awk '
      /^[^[:space:]]/ {label=$0; sub(/:$/, "", label)}
      /^[[:space:]]*\/dev\/video/ {printf "  %-16s %s\n", $1, label; found=1}
      END {if (!found) print "  No cameras found."}
    ' <<< "$listing"
  else
    for device in /dev/video*; do
      [[ -e $device ]] || continue
      label='Video device'
      [[ ! -r /sys/class/video4linux/${device##*/}/name ]] || label=$(cat "/sys/class/video4linux/${device##*/}/name")
      printf '  %-16s %s\n' "$device" "$label"
      found=1
    done
    ((found)) || printf '  No cameras found.\n'
  fi

  printf '\nAudio sources  (--mic SOURCE / --system-audio SOURCE)\n'
  if command -v pactl >/dev/null && listing=$(pactl list short sources 2>/dev/null); then
    default_source=$(pactl get-default-source 2>/dev/null) || default_source=''
    awk -v selected="$default_source" '
      NF >= 2 {
        note=($2 == selected ? " (default)" : "")
        if ($2 ~ /\.monitor$/) note=note " [system audio]"
        printf "  %s%s\n", $2, note; found=1
      }
      END {if (!found) print "  No audio sources found."}
    ' <<< "$listing"
  else
    printf '  Unavailable. Check PulseAudio/PipeWire and install pulseaudio-utils.\n'
  fi
  printf '\nUse the names above with --monitor, --camera, --mic, and --system-audio.\n\n'
}

monitor='' camera=/dev/video0 mic=default system_audio=default camera_size=640x480 camera_fps=30
camera_format='' fps=30 size=600 margin=24 position=bottom-right mirror=1 dry=0 tray=1 export=mp4
output=''
while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --devices) show_devices; exit 0 ;;
    --no-tray) tray=0; shift ;;
    --no-mirror) mirror=0; shift ;;
    --no-system-audio) system_audio=''; shift ;;
    --dry-run) dry=1; shift ;;
    --export|--monitor|--camera|--mic|--system-audio|--camera-size|--camera-fps|--camera-format|--fps|--overlay-size|--overlay-margin|--overlay-position)
      (($# >= 2)) || die "Missing value for $1"
      key=${1#--}; key=${key#overlay-}; key=${key//-/_}; printf -v "$key" '%s' "$2"; shift 2 ;;
    -*) die "Unknown option: $1" ;;
    *) [[ -z $output ]] || die 'Only one output path is allowed'; output=$1; shift ;;
  esac
done
case "$export" in
  mp4|kdenlive) ;;
  *) die 'export must be mp4 or kdenlive' ;;
esac
script_dir=$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")
if [[ $export == kdenlive ]]; then
  if [[ -x $script_dir/snapshot-kdenlive ]]; then
    kdenlive_cmd=("$script_dir/snapshot-kdenlive")
  else
    command -v python3 >/dev/null || die 'Kdenlive export requires Python 3 or the bundled snapshot-kdenlive helper.'
    [[ -f $script_dir/kdenlive.py ]] || die 'Keep kdenlive.py beside snapshot.'
    kdenlive_cmd=(python3 "$script_dir/kdenlive.py")
  fi
  command -v ffprobe >/dev/null || die 'Kdenlive export requires ffprobe.'
fi
command -v ffmpeg >/dev/null || die 'Install ffmpeg first.'
for key in fps camera_fps size; do
  [[ ${!key} =~ ^[1-9][0-9]*$ ]] || die "$key must be a positive integer"
done
[[ $margin =~ ^(0|[1-9][0-9]*)$ ]] || die 'margin must be a nonnegative integer'
[[ $camera_size =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]] || die 'camera-size must be WxH'
case "$position" in
  center) vertical=center; horizontal=center ;;
  top-left|top-center|top-right|center-left|center-right|bottom-left|bottom-center|bottom-right)
    vertical=${position%%-*}; horizontal=${position#*-} ;;
  *) die 'overlay-position must be top-left, top-center, top-right, center-left, center, center-right, bottom-left, bottom-center, or bottom-right' ;;
esac
case "$horizontal" in
  left) overlay_x=$margin ;;
  center) overlay_x='(W-w)/2' ;;
  right) overlay_x="W-w-$margin" ;;
esac
case "$vertical" in
  top) overlay_y=$margin ;;
  center) overlay_y='(H-h)/2' ;;
  bottom) overlay_y="H-h-$margin" ;;
esac
if [[ -z $output || -d $output ]]; then
  output="${output:-.}/recording-$(date +%Y%m%d-%H%M%S).$export"
fi
if [[ ${output##*/} != *.* ]]; then
  printf 'Warning: output filename has no extension: %s (writing %s).\n' "$output" "$export" >&2
fi
[[ $output == /* ]] || output="$PWD/$output"
stem=${output%.$export}
intermediate=$stem.mkv
[[ $intermediate != "$output" ]] || intermediate=$output.source.mkv
[[ ! -e $output && ! -e $intermediate ]] || die 'Output or intermediate MKV already exists; choose another filename.'

[[ ${XDG_SESSION_TYPE:-x11} != wayland ]] || die 'This script requires an X11 session. Log into an Xorg session; x11grab cannot capture a Wayland desktop.'
[[ -n ${DISPLAY:-} ]] || die 'DISPLAY is unset; run this in your desktop terminal.'
command -v xrandr >/dev/null || die 'Install x11-xserver-utils for xrandr.'
layout=$(xrandr --query) || die 'Cannot query displays; run this in your desktop terminal.'
# Restrict capture to one active output, never the entire virtual desktop.
geometry=$(awk -v name="$monitor" '
  $2 == "connected" && ((name != "" && $1 == name) || (name == "" && $3 == "primary")) {
    for (i=3; i<=NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {print $i; exit}
  }' <<< "$layout")
if [[ -z $geometry && -z $monitor ]]; then
  mapfile -t active < <(awk '$2 == "connected" {for (i=3;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) print $i}' <<< "$layout")
  ((${#active[@]} == 1)) || die 'No primary monitor set. Use --devices and --monitor NAME.'
  geometry=${active[0]}
fi
[[ $geometry =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]] || die 'Selected monitor is not active or its geometry is unsupported.'
width=${BASH_REMATCH[1]} height=${BASH_REMATCH[2]} x=${BASH_REMATCH[3]} y=${BASH_REMATCH[4]}
[[ -c $camera && -r $camera ]] || die "Cannot read webcam $camera. Use --devices to choose a camera."
# Resolve and print the default source when pactl is available.
if [[ $mic == default ]] && command -v pactl >/dev/null; then
  resolved_mic=$(pactl get-default-source 2>/dev/null) || resolved_mic=''
  [[ -z $resolved_mic ]] || mic=$resolved_mic
fi
if [[ $system_audio == default ]]; then
  command -v pactl >/dev/null || die 'Resolving default system audio requires pactl (pulseaudio-utils).'
  default_sink=$(pactl get-default-sink 2>/dev/null) || default_sink=''
  [[ -n $default_sink ]] || die 'Cannot determine the default audio output. Use --devices and pass its monitor source.'
  system_audio=$default_sink.monitor
fi
camera_node=$(readlink -f -- "$camera")
camera_label=''
if [[ -r /sys/class/video4linux/${camera_node##*/}/name ]]; then
  camera_label=$(cat "/sys/class/video4linux/${camera_node##*/}/name")
fi
printf 'Webcam: %s%s\nMicrophone source: %s\n' "$camera" "${camera_label:+ ($camera_label)}" "$mic"
[[ -z $system_audio ]] || printf 'System audio source: %s\n' "$system_audio"
inputs=(-thread_queue_size 8 -use_wallclock_as_timestamps 1 -f x11grab -probesize 32 -analyzeduration 0
        -framerate "$fps" -video_size "${width}x${height}" -draw_mouse 1 -i "${DISPLAY}+${x},${y}"
        -thread_queue_size 8 -use_wallclock_as_timestamps 1 -f v4l2 -probesize 32 -analyzeduration 0
        -framerate "$camera_fps" -video_size "$camera_size")
[[ -z $camera_format ]] || inputs+=(-input_format "$camera_format")
if [[ $export == kdenlive ]]; then
  inputs+=(-isync 0)
fi
inputs+=(-i "$camera" -thread_queue_size 512 -use_wallclock_as_timestamps 1
         -f pulse)
[[ $export != kdenlive ]] || inputs+=(-isync 0)
inputs+=(-i "$mic")
if [[ -n $system_audio ]]; then
  inputs+=(-thread_queue_size 512 -use_wallclock_as_timestamps 1 -f pulse)
  [[ $export != kdenlive ]] || inputs+=(-isync 0)
  inputs+=(-i "$system_audio")
fi
((size + 2 * margin <= width && size + 2 * margin <= height)) || die 'Circle and margin must fit inside the selected monitor.'
flip=''; ((mirror)) && flip='hflip,'
graph="[1:v]crop='min(iw,ih)':'min(iw,ih)',scale=$size:$size,setsar=1,${flip}format=yuv420p,split[cam][masksrc];[masksrc]trim=end_frame=1,format=gray,geq=lum='255*clip($size/2-hypot(X-(W-1)/2,Y-(H-1)/2),0,1)',loop=loop=-1:size=1:start=0,setpts=N/($camera_fps*TB)[mask];[cam][mask]alphamerge=shortest=1[face];[0:v][face]overlay=x=$overlay_x:y=$overlay_y:eof_action=pass,scale=trunc(iw/2)*2:trunc(ih/2)*2,format=yuv420p[v];"
if [[ -n $system_audio ]]; then
  graph+='[2:a][3:a]amix=inputs=2:duration=longest:normalize=0,aresample=async=1:first_pts=0[a]'
else
  graph+='[2:a]aresample=async=1:first_pts=0[a]'
fi
capture=(ffmpeg -hide_banner -nostdin -n -copyts -start_at_zero "${inputs[@]}"
         -filter_complex_threads 1 -filter_complex "$graph" -map '[v]' -map '[a]'
         -c:v libx264 -preset ultrafast -tune zerolatency -crf 20 -r "$fps" -c:a aac -b:a 160k)
if [[ $export == kdenlive ]]; then
  audio_maps=(-map 2:a:0)
  audio_metadata=(-metadata:s:a:0 title=Microphone)
  if [[ -n $system_audio ]]; then
    audio_maps+=(-map 3:a:0)
    audio_metadata+=(-metadata:s:a:1 'title=System Audio')
  fi
  capture=(ffmpeg -hide_banner -nostdin -n -copyts -start_at_zero "${inputs[@]}"
           -map 0:v:0 -map 1:v:0 "${audio_maps[@]}"
           -filter:v:0 'scale=trunc(iw/2)*2:trunc(ih/2)*2'
           -filter:v:1 'scale=trunc(iw/2)*2:trunc(ih/2)*2'
           -c:v libx264 -preset ultrafast -tune zerolatency -crf 20 -pix_fmt yuv420p
           -fps_mode:v passthrough -c:a aac -b:a 160k -af aresample=async=1
           -metadata:s:v:0 title=Screen -metadata:s:v:1 title=Webcam
           "${audio_metadata[@]}")
fi
capture+=("$intermediate")
export_cmd=(ffmpeg -hide_banner -nostdin -n -i "$intermediate" -map 0 -c copy -movflags +faststart -f mp4 "$output")
if [[ $export == kdenlive ]]; then
  export_cmd=("${kdenlive_cmd[@]}" "$intermediate" "$output"
              --fps "$fps" --size "$size" --margin "$margin" --position "$position")
  ((mirror)) || export_cmd+=(--no-mirror)
fi
if ((dry)); then
  printf '%q ' "${capture[@]}"; printf '\n'
  printf '%q ' "${export_cmd[@]}"; printf '\n'
  exit 0
fi
mkdir -p "$(dirname "$output")"
printf 'Recording to %s\nPress Ctrl+C to stop and export.\n' "$intermediate"
# FFmpeg handles Ctrl+C by finalizing the file; continue to remux afterward.
log=$stem.capture.log
printf 'Capture log: %s\n' "$log"
stop_requested=0
trap 'stop_requested=1' INT USR1
status=0
tray_helper="$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")/tray.py"
if ((tray)); then
  if [[ -x $script_dir/snapshot-tray ]]; then
    # A one-file PyInstaller helper has a bootloader parent, not this shell.
    capture=(env SNAPSHOT_RECORDER_PID="$$" "$script_dir/snapshot-tray" "${capture[@]}")
  elif command -v python3 >/dev/null && [[ -f $tray_helper ]]; then
    capture=(python3 "$tray_helper" "${capture[@]}")
  else
    printf 'Tray unavailable: install Python 3 and keep tray.py beside snapshot. Use Ctrl+C to stop.\n' >&2
  fi
fi
# Keep tee alive through Ctrl+C so FFmpeg can finish writing diagnostics.
"${capture[@]}" 2> >(trap '' INT; tee -a "$log" >&2) || status=$?
trap - INT USR1
if ((status != 0 && status != 255 && status != 130)); then
  die "Capture failed (exit $status). Any partial recording remains at $intermediate; diagnostics: $log"
fi
if ((!stop_requested)); then
  printf 'Warning: capture ended without Ctrl+C (exit %s). Check %s.\n' "$status" "$log" >&2
fi
[[ -s $intermediate ]] || die "No recording was produced. Check $log"
"${export_cmd[@]}" || die "Export failed; your recording remains at $intermediate"
printf '\nExported: %s\nOriginal retained: %s\n' "$output" "$intermediate"
